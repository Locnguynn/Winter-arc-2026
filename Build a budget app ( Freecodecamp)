Phần 2: Vẽ biểu đồ thống kê (create_spend_chart) — "Trùm cuối"
Hàm này nằm độc lập bên ngoài class, nhận vào danh sách nhiều danh mục để vẽ sơ đồ cột:

Python
def create_spend_chart(categories):
    # 1. Khởi tạo tiêu đề
    chart = "Percentage spent by category\n"
    
    # 2. Thu thập tổng tiền rút của từng danh mục
    spent_amounts = []
    for category in categories:
        spent = 0
        for item in category.ledger:
            if item["amount"] < 0: # Chỉ lọc số âm (tiền rút ra tiêu)
                spent += abs(item["amount"])
        spent_amounts.append(spent)
        
    total_spent = sum(spent_amounts)
    
    # 3. Tính toán tỷ lệ phần trăm và làm tròn xuống hàng chục
    percentages = []
    for amount in spent_amounts:
        percent = (amount / total_spent) * 100
        rounded_percent = int(percent / 10) * 10 # Thủ thuật làm tròn (vd: 79 -> 70)
        percentages.append(rounded_percent)
        
    # 4. Vẽ trục tung (100 đến 0) và các cột 'o'
    for i in range(100, -1, -10):
        chart += f"{i:>3}| " # Căn lề phải trục số
        for percent in percentages:
            if percent >= i:
                chart += "o  " # Nếu % đạt ngưỡng thì vẽ cục gạch
            else:
                chart += "   " # Ngược lại để trống khoảng trắng
        chart += "\n"
        
    # 5. Vẽ đường kẻ ngang dưới đáy biểu đồ
    chart += "    " + "-" * (len(categories) * 3 + 1) + "\n"
    
    # 6. Treo bảng tên danh mục dọc theo chiều dọc
    max_name_length = max([len(category.name) for category in categories])
    
    for i in range(max_name_length):
        chart += "     " # Chừa khoảng trống lề trái cho đồng bộ với cột số trên
        for category in categories:
            if i < len(category.name):
                chart += category.name[i] + "  " # In từng chữ cái dọc xuống
            else:
                chart += "   " # Điền khoảng trắng nếu tên đã hết chữ
        
        if i < max_name_length - 1:
            chart += "\n" # Xuống dòng cho các hàng chữ, trừ hàng cuối cùng
            
    return chart
